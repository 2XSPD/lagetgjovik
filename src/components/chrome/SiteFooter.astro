---
import Icon from '@/components/ui/Icon.astro';
import Logomark from '@/components/ui/Logomark.astro';
import { publicLinks, siteConfig } from '@/config/site';
import { socialIcon } from '@/lib/socials';

interface Props {
  closing?: boolean;
}

const { closing: showClosing = true } = Astro.props;
const { email } = siteConfig.org;
const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line sm:mt-32 bg-accent">
  <div class="shell grid gap-12 py-16 sm:grid-cols-2 lg:grid-cols-[1.6fr_1fr_1fr_1fr]">
    <div>
      <a href="/" class="inline-flex items-center gap-2.5 text-[1.15rem] font-semibold tracking-[-0.03em]" aria-label="Til hjemmeside">
        <Logomark class="h-11" />
      </a>
      <p class="mt-5 max-w-xs text-surface">
        {siteConfig.name}
      </p>
      <p class="mt-0 max-w-xs text-surface">
        Org.nr: <a class="footer-link" href={`https://virksomhet.brreg.no/nb/oppslag/enheter/${siteConfig.org.orgnr}`} target="_blank" rel="noopener noreferrer">{siteConfig.org.orgnr}</a>
      </p>
    </div>

    <nav aria-labelledby="footer-elsewhere">
      <h2 id="footer-elsewhere" class="text-sm text-surface">
        Hvor du finner oss
      </h2>
      <ul class="mt-2 grid gap-2.5">
        {siteConfig.socials.map((social) => (
          <li>
            <a class="footer-link inline-flex items-center gap-2.5" href={social.href} rel="me noopener" target="_blank">
              <Icon name={socialIcon(social.label)} class="size-3.5 text-surface translate-y-[1px]" />
              {social.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <nav aria-labelledby="footer-pages">
      <h2 id="footer-pages" class="text-sm text-surface">
        Kontakt oss
      </h2>
      <ul class="mt-2 grid gap-2.5">
        <li>
          <a class="footer-link" href={`mailto:${siteConfig.org.email}`}>
            {siteConfig.org.email}
          </a>
        </li>
      </ul>
    </nav>

      <nav aria-labelledby="footer-legal">
        <h2 id="footer-legal" class="text-sm text-surface">
          Dokumenter
        </h2>
        <ul class="mt-2 grid gap-2.5">
          {publicLinks.map((link) => (
            <li>
              <a class="footer-link" href={link.href} target="_blank" rel="noopener noreferrer">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
  </div>

  <div class="footer-credit">
    <div class="shell flex flex-wrap items-center justify-between gap-4 py-6 text-sm text-surface ">
      <p>
        &copy; {year} {siteConfig.name}.
      </p>
      <a href="#content" class="footer-link inline-flex items-center gap-1.5 hover:text-surface/80">
        Tilbake til toppen
        <Icon name="arrow-up" class="size-3.5" />
      </a>
    </div>
  </div>
</footer>

<style>
  .footer-link {
    color: var(--surface);
    transition: color 160ms ease;
  }

  .footer-link:hover {
    color: var(--canvas);
    text-decoration: underline;
  }

  .footer-credit{
    background: color-mix(in oklab, var(--ink) 25%, transparent);
  }


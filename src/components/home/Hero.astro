---
import { Image } from 'astro:assets';
import heroimage from '@/assets/images/hero-img.jpg';
import Icon from '@/components/ui/Icon.astro';
import { hero } from '@/config/home';
---

<section class="shell pt-14 pb-20 sm:pt-20 sm:pb-28 lg:pt-24" aria-labelledby="hero-title">
  <div class="flex flex-col gap-16 lg:gap-24 lg:flex-row-reverse lg:items-end">
    <div class="rise" style="--rise-step: 3">
    <Image
      src={heroimage}
      alt=""
      layout="full-width"
      loading="eager"
      class="rounded-2xl object-cover object-top shadow-lg shadow-[0_1px_2px_rgb(18_18_17/0.04)] object-contain max-h-[300px] lg:max-h-[400px]"
    />
  </div>
  <div class="flex flex-col gap-6 lg:gap-8">
    <h1 id="hero-title" class="rise max-w-[10ch] text-display">
      {hero.title}
    </h1>

    <div class="rise">
      <p class="max-w-xl text-lead text-body">{hero.text}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class="btn btn-primary" href={hero.primary.href}>
          {hero.primary.label}
          <Icon name="arrow-right" class="icon-nudge size-4" />
        </a>
        <a class="btn btn-ghost" href={hero.secondary.href}>
          {hero.secondary.label}
        </a>
      </div>
    </div>
  </div>

</div>
  
</section>

<style>
  .availability-dot {
    position: relative;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: #22a55b;
  }

  @media (prefers-reduced-motion: no-preference) {
    .availability-dot::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
      background: inherit;
      animation: ping 2.4s cubic-bezier(0, 0, 0.2, 1) infinite;
    }
  }

  @keyframes ping {
    75%,
    100% {
      transform: scale(2.4);
      opacity: 0;
    }
  }
</style>

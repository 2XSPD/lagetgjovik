---
import { Image } from 'astro:assets';
import portrait from '@/assets/images/maria.webp';
import Icon from '@/components/ui/Icon.astro';
import { about } from '@/config/about';
import { siteConfig } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { profileSchema } from '@/lib/schema';
---

<BaseLayout
  title="About us"
  description={`About ${siteConfig.title}.`}
  type="profile"
  structuredData={profileSchema('/english/')}
>
  <header class="shell grid gap-12 pt-16 sm:pt-24 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-end lg:gap-16">
    <div>
      <hgroup>
        <h1 class="rise mt-6 max-w-[18ch] text-headline" style="--rise-step: 1">
        {about.title}
      </h1>
      <h2 class="rise mt-6 max-w-[18ch] text-section" style="--rise-step: 1">
        {about.subtitle}
      </h2>
      </hgroup>
      
      <p class="rise mt-6 max-w-2xl text-lead text-body" style="--rise-step: 2">
        {about.text}
      </p>
      <div class="rise mt-8 flex flex-wrap gap-3" style="--rise-step: 3">
        <a class="btn btn-accent" href="https://nkss.no/english/" target="_blank" rel="noopener noreferrer">
          Learn more about Laget
        </a>
        <a class="btn btn-primary" href="https://ifesworld.org/en/about/" target="_blank" rel="noopener noreferrer">
          Learn more about IFES
        </a>
      </div>
    </div>
  </header>

  <section class="shell mt-16 sm:mt-24" aria-labelledby="principles-title">
    <h2 id="principles-title" class="reveal text-section">
      {about.principles.title}
    </h2>
    <ol class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {about.principles.items.map((item, index) => (
        <li class="reveal rounded-card border border-line bg-surface p-7">
          <span class="font-serif text-3xl text-muted italic" aria-hidden="true">
            {String(index + 1).padStart(2, '0')}
          </span>
          <h3 class="mt-8 text-title">{item.title}</h3>
          <p class="mt-3 text-muted">{item.text}</p>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>
